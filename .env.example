# Neon Postgres (pooler for app; use direct host for migrations)
# 使用 pooler 时建议加 pgbouncer=true（Neon + Prisma）
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Clerk: optional. Leave unset for keyless mode (Clerk generates temp keys locally).
# Set when you claim the app at https://dashboard.clerk.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
# CLERK_SECRET_KEY=sk_test_xxxx

# Google Cloud Translation API v2. Required only when a PDF contains Chinese.
# GOOGLE_CLOUD_TRANSLATE_API_KEY=
